SELECT t.trip_id, st.stop_sequence, s.stop_name, st.arrival_time, st.departure_time
FROM trips t
JOIN stop_times st ON t.trip_id = st.trip_id
JOIN stops s ON st.stop_id = s.stop_id
WHERE t.route_id = '10'
  AND t.service_id IN (SELECT service_id FROM calendar WHERE monday = 1)
ORDER BY t.trip_id, st.stop_sequence;

